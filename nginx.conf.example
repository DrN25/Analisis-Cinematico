# Plantilla de configuración Nginx para DigitalOcean Droplet
# Copiar a /etc/nginx/sites-available/gema-cinematico y enlazar a sites-enabled

server {
    listen 80;
    server_name tu-dominio-o-ip.com;

    # Límite máximo de carga en peticiones (80 KB o superior)
    client_max_body_size 10M;

    location / {
        proxy_pass http://127.0.0.1:8002;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Timeouts para análisis pesados
        proxy_connect_timeout 60s;
        proxy_send_timeout 120s;
        proxy_read_timeout 120s;
    }
}
